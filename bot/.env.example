# BotFather orqali olingan token
BOT_TOKEN=

# Admin(lar) telegram ID lari, vergul bilan ajratib yozing (masalan: 111111,222222)
ADMIN_IDS=

# Audit login/parollari endi bot ichida /auditlar buyrug'i orqali
# admin tomonidan har bir xodimga alohida beriladi (bazada saqlanadi).

# Ixtiyoriy: standart holatda bot/data/bot.db ishlatiladi
# DATABASE_URL=sqlite+aiosqlite:///bot/data/bot.db

# CRM ma'lumotlari (guruhlar/o'quvchilar/to'lovlar) backendning o'z Postgres bazasidan
# to'g'ridan-to'g'ri (faqat SELECT, backend.models + backend.core_calc orqali) o'qiladi —
# bot CRMga hech narsa yozmaydi, davomat esa botning o'z bazasida saqlanadi.
# Bu backend o'zi ishlatadigan DATABASE_URL bilan bir xil bo'lishi kerak. Bot va backend bir
# serverda ishlasa, odatda: postgresql://postgres:PAROL@localhost:5432/ithub_db
# Bo'sh qoldirilsa, backend/database.py'ning o'z standart qiymatiga tayaniladi.
CRM_DB_URL=
