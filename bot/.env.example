# BotFather orqali olingan token
BOT_TOKEN=

# Admin(lar) telegram ID lari, vergul bilan ajratib yozing (masalan: 111111,222222)
ADMIN_IDS=

# Audit login/parollari endi bot ichida /auditlar buyrug'i orqali
# admin tomonidan har bir xodimga alohida beriladi (bazada saqlanadi).

# Ixtiyoriy: standart holatda bot/data/bot.db ishlatiladi
# DATABASE_URL=sqlite+aiosqlite:///bot/data/bot.db

# CRM (backend) — guruhlar/o'quvchilar shu yerdan olinadi, davomat (kelish/ketish) shu yerga yoziladi.
# Backend ishga tushirilgan bo'lishi kerak (masalan: docker compose up, yoki uvicorn backend.main:app).
CRM_BASE_URL=http://localhost:8000
# Production (nginx orqali): CRM_API_PREFIX=/api . To'g'ridan-to'g'ri uvicorn uchun: bo'sh qoldiring.
CRM_API_PREFIX=/api
CRM_USERNAME=admin
CRM_PASSWORD=Admin@2026
