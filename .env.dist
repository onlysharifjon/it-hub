# ─────────────────────────────────────────────
#  IT Hub — Environment variables template
#  Nusxa oling: cp .env.dist .env
#  Va o'zingizning qiymatlaringizni kiriting
# ─────────────────────────────────────────────

# PostgreSQL ulanish manzili
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/ithub_db

# JWT uchun maxfiy kalit (kamida 32 ta belgi, tasodifiy qiymat)
# Generatsiya: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# Token amal qilish muddati (daqiqalarda), default: 480 (8 soat)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ruxsat berilgan CORS manzillar (vergul bilan ajrating)
# Development: http://localhost:5173
# Production:  https://yourdomain.com
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite) ─────────────────────────
# Frontendda foydalanish uchun frontend/.env fayliga ko'chiring
# VITE_ prefiksi majburiy

# Backend API manzili (default: http://localhost:8000)
VITE_API_BASE=http://localhost:8000
