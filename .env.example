# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ithub_user:IthubSecure2026@localhost:5432/ithub_db

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720          # 12h — long-lived tokens are a risk

# API hujjatlari (/docs, /redoc, /openapi.json) HTTP Basic parol bilan himoyalangan.
# Brauzer login+parol so'raydi; login e'tiborga olinmaydi, faqat quyidagi parol tekshiriladi.
DOCS_PASSWORD=1107

# Admin akkaunti startup'da faqat shu env orqali yaratiladi (kodda default parol yo'q).
# ADMIN_PASSWORD berilmasa admin yaratilmaydi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# Demo akkountlar (metodist/teacher/hunter/callcenter) faqat dev uchun:
SEED_DEMO_USERS=false
DEMO_PASSWORD=

# ── Ota-ona mobil ilovasi (Parent API) ────────────────────────────────────────
# Access token 30 daqiqa, refresh 30 kun (default). Xohlasangiz o'zgartiring.
PARENT_ACCESS_TTL_MIN=30
PARENT_REFRESH_TTL_DAYS=30
# Eslatma: ota-onalar OTP/SMS bilan emas, hunter/admin bergan login+parol bilan kiradi.
# Onlayn to'lov (Payme/Click/Uzum) hozircha STUB — real merchant kalitlari keyin.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dev: http://localhost:5173   |   Docker: http://localhost   |   Prod: https://ithub.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Docker Compose only) ───────────────────────────────────────────
# URL that the BROWSER uses to reach the backend (baked into JS bundle at build time)
VITE_API_BASE=http://localhost:8000

# Uy vazifasi boti (BotFather token)
TELEGRAM_BOT_TOKEN=

# Tashqi (mobil ilova) linklar uchun bazaviy URL — sertifikat PDF havolalari shu bilan yasaladi
PUBLIC_BASE_URL=https://crm.minaracademy.uz

# ── Facebook Lead Ads webhook (Make.com -> POST /api/leads/facebook) ─────────
# Make.com so'rov header'ida X-Webhook-Token: <shu qiymat> yuborishi shart.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FACEBOOK_WEBHOOK_TOKEN=
