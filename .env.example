# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ithub_user:IthubSecure2026@localhost:5432/ithub_db

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=                               # MAJBURIY, kamida 16 belgi: python -c 'import secrets;print(secrets.token_urlsafe(48))'
ACCESS_TOKEN_EXPIRE_MINUTES=720          # 12h — long-lived tokens are a risk

# API hujjatlari (/docs, /redoc, /openapi.json) HTTP Basic parol bilan himoyalangan.
# Brauzer login+parol so'raydi; login e'tiborga olinmaydi, faqat quyidagi parol tekshiriladi.
DOCS_PASSWORD=                            # bo'sh — /docs yopiq

# Admin akkaunti startup'da faqat shu env orqali yaratiladi (kodda default parol yo'q).
# ADMIN_PASSWORD berilmasa admin yaratilmaydi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# Demo akkountlar (metodist/teacher/hunter/callcenter) faqat dev uchun:
SEED_DEMO_USERS=false
DEMO_PASSWORD=

# ── Ota-ona mobil ilovasi (Parent API) ────────────────────────────────────────
# Access token 30 daqiqa, refresh 30 kun (default). Xohlasangiz o'zgartiring.
PARENT_ACCESS_TTL_MIN=30
PARENT_REFRESH_TTL_DAYS=30
# Eslatma: ota-onalar OTP/SMS bilan emas, hunter/admin bergan login+parol bilan kiradi.
# Rotatsiyalangan refresh token shu soniya ichida qayta kelsa — faqat 401 (parallel so'rov);
# keyinroq kelsa — o'g'irlik deb hisoblanib, ota-onaning barcha sessiyalari bekor qilinadi.
PARENT_REFRESH_REUSE_GRACE_SEC=10
# Sertifikat havolasi (imzolangan, Bearer'siz) amal qilish muddati, soat
PARENT_CERT_URL_TTL_HOURS=24
# Matnli jadvaldan ("Toq kunlar" + lesson_time) slot yasashda dars davomiyligi, daqiqa
PARENT_DEFAULT_LESSON_MINUTES=120

# ── Telefon + Telegram OTP login (ota-ona ilovasi) — docs/parent-api/phone-otp.md ──
# Token faqat backend env'da; mobil ilovaga, logga yoki javobga hech qachon berilmaydi.
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_BASE_URL=https://gatewayapi.telegram.org
# Kod yuboriladigan raqam prefikslari (vergul bilan) — xarajatni cheklash uchun
PHONE_OTP_ALLOWED_PREFIXES=+998

# ── Onlayn to'lov (ota-ona ilovasi) — docs/parent-api/README.md ───────────────
# Provayder sozlanmagan bo'lsa /pay → 503 payment_provider_unavailable (soxta link berilmaydi).
PAYMENT_MIN_AMOUNT=1000
PAYMENT_MAX_AMOUNT=20000000
PARENT_INVOICE_TTL_MIN=720
PAYMENT_ALLOW_REFUND=true
# To'lovdan keyin brauzer qaytadigan sahifa (faqat https). Qaytish to'lov tasdig'i EMAS.
PAYMENT_RETURN_URL=
# Payme (Paycom) Merchant API — callback: POST {PUBLIC_BASE_URL}/api/payment-callbacks/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# sandbox: https://checkout.test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_ACCOUNT_FIELD=invoice_id
# Click SHOP API — callback: .../api/payment-callbacks/click/prepare va .../click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Uzum Bank Merchant API — callback: .../api/payment-callbacks/uzum/{check,create,confirm,reverse,status}
UZUM_SERVICE_ID=
UZUM_LOGIN=
UZUM_PASSWORD=
UZUM_ACCOUNT_FIELD=order_id

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dev: http://localhost:5173   |   Docker: http://localhost   |   Prod: https://ithub.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Docker Compose only) ───────────────────────────────────────────
# URL that the BROWSER uses to reach the backend (baked into JS bundle at build time)
VITE_API_BASE=http://localhost:8000

# Uy vazifasi boti (BotFather token)
TELEGRAM_BOT_TOKEN=

# Tashqi (mobil ilova) linklar uchun bazaviy URL — sertifikat PDF havolalari shu bilan yasaladi
PUBLIC_BASE_URL=https://crm.minaracademy.uz

# ── Facebook Lead Ads webhook (Make.com -> POST /api/leads/facebook) ─────────
# Make.com so'rov header'ida X-Webhook-Token: <shu qiymat> yuborishi shart.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FACEBOOK_WEBHOOK_TOKEN=

# Kamera servisi kaliti (bo'sh — /camera/* API o'chiq)
CAMERA_API_KEY=
# Docker: Postgres paroli (docker-compose.yml da majburiy)
POSTGRES_PASSWORD=
# Rate limiter (login brute-force himoyasi); false — o'chiq
RATE_LIMIT_ENABLED=true
# Avtomatik backup (backend/scripts/backup_db.py)
BACKUP_KEEP_DAYS=14
