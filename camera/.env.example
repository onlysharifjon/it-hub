# ── Kamera (RTSP) ─────────────────────────────────────────────────────────────
# Dahua NVR: channel=kamera raqami, subtype=0 (asosiy) / 1 (past sifat)
RTSP_URL=rtsp://admin:parol@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
FRAME_SKIP=5
DETECTION_MODEL=hog
RECOGNITION_TOLERANCE=0.5

# ── Keldi/Ketdi mantiq ────────────────────────────────────────────────────────
# Bola/xodim ko'rinmasa ketdi deb hisoblanish vaqti (soniya)
ABSENCE_TIMEOUT=180
# Bir shaxsga xabar orasidagi minimal vaqt (soniya, spamni oldini oladi)
NOTIFY_COOLDOWN=300

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=1234567890:ABC-DEFxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_CHAT_ID=-1001234567890
# true = ota-onaga shaxsiy xabar yuboriladi (talaba telegram_id bo'lsa)
NOTIFY_PARENT=true

# ── CRM Server ────────────────────────────────────────────────────────────────
CRM_URL=http://192.168.1.100:8000
# backend docker-compose.yml dagi CAMERA_API_KEY bilan bir xil bo'lishi kerak
CAMERA_API_KEY=minar-camera-secret-2026
# O'quvchilar ro'yxatini qancha vaqtda yangilash (soniya)
SYNC_INTERVAL=3600

# ── Ma'lumotlar bazasi ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ithub_user:IthubSecure2026@localhost:5432/ithub_db

