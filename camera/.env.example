# ── Kamera (RTSP) ─────────────────────────────────────────────────────────────
# Dahua NVR: channel=kamera raqami, subtype=0 (asosiy oqim) / 1 (past sifat)
RTSP_URL=rtsp://admin:parol@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
FRAME_SKIP=5
DETECTION_MODEL=hog
RECOGNITION_TOLERANCE=0.5

# ── Keldi/Ketdi ───────────────────────────────────────────────────────────────
ABSENCE_TIMEOUT=180
NOTIFY_COOLDOWN=300

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=123456:ABC-DEF...
NOTIFY_CHAT_ID=-1001234567890
NOTIFY_STUDENT=false

# ── Baza (backend bilan bir xil) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:parol@localhost:5432/ithub_db

# ── Yuzlar ────────────────────────────────────────────────────────────────────
# FACES_DIR=./faces
